/*  $C000-C3FF - VIDEO */
/*  $C400-C7FF - IRQ latch */
/*  $C800-CBFF - ACIA */
/*  $CC00-CCFF - VIA */
/*  $CD00-CDFF - DEV0 */
/*  $CE00-CEFF - DEV1 */
/*  $CF00-CFFF - DEV2 */
/*  $0000-$7FFF - RAM1 */
/*  $8000-$BFFF - RAM2 */
/*  $E000-$FFFF - ROM */

/* Pin Map 
       --------
CLK   |1     24| Vcc
A15   |2     23| /IRQ_CS
A14   |3     22| /ACIA_CS
A13   |4     21| /RAM_CS
A12   |5     20| /RAM2_CS
A11   |6     19| /ROM_CS
A10   |7     18| /VIDEO_CS
A9    |8     17| /VIA_CS
A8    |9     16| /DEV0_CS
A7    |10    15| /DEV1_CS
A6    |11    14| /DEV2_CS
Gnd   |12    13| /EXROM
       --------
*/

/*
 * Inputs:  All are signals from the 6502, 65C02, 65816
 */

Pin 1  =  CLK;
Pin 2  =  A15;
Pin 3  =  A14;
Pin 4  =  A13;
Pin 5  =  A12;
Pin 6  =  A11;
Pin 7  =  A10;
Pin 8  =  A9;
Pin 9  =  A8;
Pin 10 =  A7;
Pin 11 =  A6;
Pin 13 = EXROM;
/*
 * Outputs:  define outputs - all are simple combinatorial
 */
Pin 23 = !IRQ_CS;      /* to RAM and ROM chips */
Pin 22 = !ACIA_CS;      /* to RAM and ROM chips */
Pin 21 = !RAM_CS; /* to RAM1 /CS pin */
Pin 20 = !RAM2_CS; /* to RAM2 /CS pin */
Pin 19 = !ROM_CS;  /* to ROM  /CS pin */
Pin 18 = !VIDEO_CS;   /* to IOCS pin */
Pin 17 = !VIA_CS;   /* to IOCS pin */
Pin 16 = !DEV0_CS;   /* to IOCS pin */
Pin 15 = !DEV1_CS;   /* to IOCS pin */
Pin 14 = !DEV2_CS;   /* to IOCS pin */


/*
 * Local variables
 */

FIELD Address = [A15..A6];

/*
 * Logic:
 */

IO_CS     = A15 & A14 & !A13 & !A12;
OTHER_CS  = IO_CS & A11 & A10;

RAM_CS   = !A15;                         /* $0000-$7FFF */
RAM2_CS  = A15 & !A14;                   /* $8000-$BFFF */
ROM_CS   = A15 & A14 & A13;              /* $E000-$FFFF */

VIDEO_CS = IO_CS & !A11 & !A10;          /* $C000-$C3FF */
IRQ_CS   = IO_CS & !A11 & A10;           /* $C400-$C7FF */
ACIA_CS  = IO_CS & A11 & !A10;           /* $C800-$CBFF */
VIA_CS   = OTHER_CS & !A9 & !A8;         /* $CC00-$CCFF */
DEV0_CS  = OTHER_CS & !A9 & A8;          /* $CD00-$CDFF */
DEV1_CS  = OTHER_CS & A9 & !A8;          /* $CE00-$CEFF */
DEV2_CS  = OTHER_CS & A9 & A8;           /* $CF00-$CFFF */
